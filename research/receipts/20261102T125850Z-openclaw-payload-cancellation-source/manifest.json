  "files": [
    {
      "filename": "config/test-lines-allocations/chat-completions-payload-cancellation.txt",
      "status": "added",
      "additions": 2,
      "deletions": 0,
      "changes": 2,
      "sha": "45c2f82e5f3a0ceb86b8bd5f7b391b334fd32d5c",
      "patch": "@@ -0,0 +1,2 @@\n+# Direct/managed Chat Completions payload-hook cancellation and retained-work proof.\n+71"
    },
    {
      "filename": "packages/ai/README.md",
      "status": "modified",
      "additions": 4,
      "deletions": 3,
      "changes": 7,
      "sha": "3cdac1b8d11cc0fc32b6dc742fbeb15ce4b0c02d",
      "patch": "@@ -35,9 +35,10 @@ OpenAI HTTP adapters report rejected response status and headers through\n invoke the callback before the first event. Retry and failover policy remains\n with the application.\n \n-Anthropic Messages calls stop waiting for payload and response hooks when the\n-request signal aborts. A hook can continue running after cancellation; embedding\n-hosts can retain that work through `observePendingProviderWork` until it settles.\n+Anthropic Messages and OpenAI-compatible Chat Completions calls stop waiting for\n+payload and response hooks when the request signal aborts. A hook can continue\n+running after cancellation; embedding hosts can retain that work through\n+`observePendingProviderWork` until it settles.\n \n Hosts that attach request state to async contexts should supply\n `runInDetachedAsyncContext` from a context-free root initialized before requests"
    },
    {
      "filename": "packages/ai/src/transports/openai-completions-transport.response-hook.test.ts",
      "status": "modified",
      "additions": 73,
      "deletions": 2,
      "changes": 75,
      "sha": "c097a62d89539c94bba5e6873e285d5593768270",
      "patch": "@@ -1,5 +1,10 @@\n-import { afterEach, beforeEach, expect, it, type MockInstance, vi } from \"vitest\";\n-import { createDeferred, withinTest, nextEventLoopTurn } from \"../../../../test/helpers/promise.js\";\n+import { afterEach, beforeEach, describe, expect, it, type MockInstance, vi } from \"vitest\";\n+import {\n+  awaitGateBeforeSettlement,\n+  createDeferred,\n+  withinTest,\n+  nextEventLoopTurn,\n+} from \"../../../../test/helpers/promise.js\";\n import { configureAiTransportHost, getAiTransportHost } from \"../host.js\";\n import { streamOpenAICompletions } from \"../providers/openai-completions.js\";\n import type { AssistantMessageEventStreamLike, Context, StreamOptions } from \"../types.js\";\n@@ -190,6 +195,72 @@ it(\"applies the first-event timeout while the hook is pending\", async ({ signal\n   lifecycle.assertListenersRemoved();\n });\n \n+describe.each([\n+  { route: \"direct\", late: \"resolve\" },\n+  { route: \"managed\", late: \"reject\" },\n+] as const)(\"$route payload hook's late $late\", ({ route, late }) => {\n+  it(\"returns cancellation before the hook settles without releasing its work\", async ({\n+    signal,\n+  }) => {\n+    const controller = new AbortController();\n+    const entered = createDeferred();\n+    const hook = createDeferred();\n+    const observed: Promise<unknown>[] = [];\n+    const fetch = vi.fn<typeof globalThis.fetch>().mockResolvedValue(\n+      new Response('data: {\"choices\":[{\"delta\":{},\"finish_reason\":\"stop\"}]}\\n\\ndata: [DONE]\\n\\n', {\n+        headers: { \"content-type\": \"text/event-stream\" },\n+      }),\n+    );\n+    configureAiTransportHost({\n+      ...getAiTransportHost(),\n+      buildModelFetch: () => fetch,\n+      observePendingProviderWork: (pending) => observed.push(pending),\n+    });\n+    const options = {\n+      signal: controller.signal,\n+      onPayload: () => {\n+        entered.resolve();\n+        return hook.promise;\n+      },\n+    };\n+    const stream =\n+      route === \"direct\"\n+        ? streamOpenAICompletions(model, context, { apiKey: \"fixture-token\", ...options })\n+        : createStream(options);\n+    try {\n+      await withinTest(\n+        awaitGateBeforeSettlement(\n+          entered.promise,\n+          stream.result(),\n+          \"Stream ended before payload hook\",\n+        ),\n+        signal,\n+      );\n+      controller.abort(Object.assign(new Error(\"payload canceled\"), { code: \"CALLER_ABORTED\" }));\n+      const result = await withinTest(stream.result(), signal);\n+      expect(result).toMatchObject({ stopReason: \"aborted\", errorCode: \"CALLER_ABORTED\" });\n+      let drained = false;\n+      const draining = Promise.allSettled(observed).then(() => {\n+        drained = true;\n+      });\n+      await nextEventLoopTurn();\n+      expect(drained).toBe(false);\n+      expect(fetch).not.toHaveBeenCalled();\n+      if (late === \"resolve\") {\n+        hook.resolve();\n+      } else {\n+        hook.reject(new Error(\"late payload failure\"));\n+      }\n+      await draining;\n+      expect(await stream.result()).toBe(result);\n+      expect(fetch).not.toHaveBeenCalled();\n+    } finally {\n+      hook.resolve();\n+      await Promise.allSettled([...observed, stream.result()]);\n+    }\n+  });\n+});\n+\n it(\"keeps caller cancellation terminal after a late hook rejection\", async ({ signal }) => {\n   const lifecycle = installResponse();\n   const controller = new AbortController();"
    },
    {
      "filename": "packages/ai/src/transports/openai-completions-transport.ts",
      "status": "modified",
      "additions": 5,
      "deletions": 1,
      "changes": 6,
      "sha": "e66b58c59cab6ad99b54c97e410044eefc0b5411",
      "patch": "@@ -73,6 +73,7 @@ import {\n } from \"./provider-transport-turn-state.js\";\n import { resolveOpencodeSessionHeaders } from \"./session-affinity.js\";\n import {\n+  awaitProviderLifecycleCallback,\n   createWritableTransportEventStream,\n   failTransportStream,\n   finalizeTransportStream,\n@@ -414,7 +415,10 @@ export function streamOpenAICompletionsRequest(\n       const builtParams = buildOpenAICompletionsRequest(model, requestContext, options, policy);\n       let params = builtParams;\n       const encodeBody = prepareModelRequestBody(options);\n-      const nextParams = await options?.onPayload?.(params, model);\n+      const nextParams = await awaitProviderLifecycleCallback(\n+        options?.onPayload ? () => options.onPayload?.(params, model) : undefined,\n+        options?.signal,\n+      );\n       if (nextParams !== undefined) {\n         params = nextParams as typeof params;\n       }"
    }
