      "inserted_nonblank_lines": [
        "from fla.modules.fused_linear_cross_entropy.ops import logsumexp_fwd as fused_linear_logsumexp_fwd",
        "from fla.ops.utils.logsumexp import logsumexp_fwd",
        "def test_fused_linear_logsumexp_row_tail():",
        "    torch.manual_seed(42)",
        "    x = torch.zeros(2, 1025, device=device)",
        "    softcap = 0.5",
        "    ref = (softcap * torch.tanh(x / softcap)).logsumexp(-1)",
        "    tri = fused_linear_logsumexp_fwd(x, scale=1.0, softcapping=softcap)",
        "    assert_close(\"lse\", ref, tri, ratio=1e-2)",
        "def test_logsumexp_row_tail_zero_scale():",
        "    torch.manual_seed(42)",
        "    x = torch.zeros(2, 1025, device=device)",
        "    ref = (x * 0.0).logsumexp(-1)",
        "    tri = logsumexp_fwd(x, scale=0.0)",
        "    assert_close(\"lse\", ref, tri, ratio=1e-2)"
      ],
      "AST_equal_after_only_declared_additions": true
    }
  ],
  "PR_and_merge_patch_sets_exact": true,
  "all_parent_landed_blobs_verified": true,
  "fact": "Four post-transform tail masks added: default fused-linear LSE, Ascend rowwise and block LSE, shared utility LSE. Two direct2x1025 regression functions added: fused-linear softcap0.5/scale1 and utility scale0.",
  "source_inference": "Softcapping can turn a padded -inf into a finite negative softcap; zero scaling can turn padded -inf into NaN. Restoring -inf after these transforms excludes padded lanes before max/exp/sum. This is code-derived numerical reasoning, not an executed kernel result.",
  "caller_and_dispatch": "Default fused-linear logsumexp_fwd is dispatched; Ascend logsumexp_fwd_npu registers for that function and launches ROWWISE=True. The new test invokes the dispatch entry but does not itself assert selected backend; the non-rowwise Ascend branch is changed but not forced by either new test.",
  "test_limits": "Two new tests compare LSE forward only. They do not directly assert loss/parameter gradients, backward equivalence, throughput or every backend branch. Author collect-only failed locally because Triton had no active driver; no author before/after accelerator result in PR body.",
